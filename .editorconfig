# https://editorconfig.org
# Supported by VS Code, JetBrains, Sublime, Nova and most editors out of the
# box (or with a small plugin). Keeps formatting consistent across macOS,
# Windows and Linux without anyone needing to configure anything.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{diff,patch}]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# Everstory — environment configuration
#
# Copy to `.env.local` and edit:
#     cp .env.example .env.local        (macOS, Linux)
#     copy .env.example .env.local      (Windows)
#
# Everything below is optional. With no file at all, Everstory runs on an
# embedded Postgres database stored in `.data/` — which is why `npm run dev`
# works on a fresh clone with nothing configured.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ database
# Unset  -> embedded Postgres (PGlite). Zero setup, single process, files in
#           .data/pgdata. Perfect for one machine; do not use for a multi-user
#           deployment.
# Set    -> a real Postgres server. Required for serverless (Vercel) and
#           recommended for anything with more than one writer.
# DATABASE_URL=postgres://everstory:everstory@localhost:5432/everstory

# Connection pool size (Postgres driver only).
# DATABASE_POOL_MAX=10

# Where local state lives: embedded database, uploads, test database.
# EVERSTORY_DATA_DIR=.data

# ----------------------------------------------------------------------- app
# Public URL. Used for share links, OAuth callbacks and export metadata.
# NOTE: NEXT_PUBLIC_* values are compiled into the browser bundle at BUILD
# time, so change it before building, not after.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------- auth
# credentials  -> email + password (default)
# single       -> no sign-in at all; the app is one person's private book.
#                 Intended for a personal machine or a single-writer install.
AUTH_MODE=credentials

# Allow new accounts to register themselves. Defaults to true in development
# and false in production, so set it explicitly when you deploy.
ALLOW_SIGNUP=true

# Days a session stays valid.
SESSION_TTL_DAYS=30

# --------------------------------------------------------------- OAuth (opt.)
# Leave these unset and the buttons simply do not appear. No code changes are
# needed to turn social sign-in on or off.
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: {APP_URL}/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -------------------------------------------------------------------- storage
# disk -> uploads on the local filesystem under EVERSTORY_DATA_DIR
# s3   -> any S3-compatible service (AWS S3, Cloudflare R2, MinIO, Backblaze
#         B2, Hetzner, Supabase Storage)
STORAGE_DRIVER=disk
MAX_UPLOAD_MB=10

# Uncomment for S3-compatible storage.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=everstory
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required for MinIO and most non-AWS providers; leave off for AWS S3.
# S3_FORCE_PATH_STYLE=true
# Optional CDN or public bucket base URL, e.g. https://media.example.com
# S3_PUBLIC_URL=

# ------------------------------------------------------------ misc (optional)
# Use TLS when connecting to Postgres (or set sslmode=require in the URL).
# PGSSL=false

# Normalise line endings on checkin and always check out LF.
#
# This is the single most important file for a project that is developed on
# both macOS and Windows. Without it, a shell script written on a Mac can be
# checked out on Windows with CRLF endings and fail in CI with a cryptic
# "bad interpreter" error.
* text=auto eol=lf

# Windows scripts must keep CRLF or they will not run.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
*.ps1 text eol=crlf

# Unix scripts must keep LF.
*.sh text eol=lf

# Binary files — never try to merge or diff these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.epub binary
*.zip binary

# Lockfiles are generated; keep them out of diffs and language statistics.
package-lock.json -diff linguist-generated=true
drizzle/** linguist-generated=true
